<?xml version="1.0" encoding="UTF-8"?>

<component name="MainScene" extends="Scene" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://rokudev.roku.com/rokudev/schema/RokuSceneGraph.xsd" initialFocus="channelList">

<!-- Core scene init, SetContent, loadPlaylist -->
<script type="text/brightscript" uri="pkg:/components/MainScene/MainScene.brs"/>
<!-- ManifestPatcher and LocalProxy callbacks -->
<script type="text/brightscript" uri="pkg:/components/MainScene/ManifestCallbacks.brs"/>
<!-- iif, detectStreamFormat, BUILTIN_PLAYLIST_COUNT, getFriendlyError, getLanguageName, toStr, isValidUrl -->
<script type="text/brightscript" uri="pkg:/components/MainScene/Utils.brs"/>
<!-- Icon selection, category matching, logo load callbacks -->
<script type="text/brightscript" uri="pkg:/components/MainScene/IconHelpers.brs"/>
<script type="text/brightscript" uri="pkg:/components/Shared/PlaylistSort.brs"/>
<!-- Save / load / restore last playlist + channel across launches -->
<script type="text/brightscript" uri="pkg:/components/MainScene/StateManager.brs"/>
<!-- Playlist data: load/save from registry, side-panel menu, selection -->
<script type="text/brightscript" uri="pkg:/components/MainScene/PlaylistManager.brs"/>
<!-- Per-playlist Edit Name / Edit URL / Delete dialogs -->
<script type="text/brightscript" uri="pkg:/components/MainScene/PlaylistEditDialogs.brs"/>
<!-- Add-new-playlist two-step dialog + shared dialog helpers -->
<script type="text/brightscript" uri="pkg:/components/MainScene/PlaylistAddDialog.brs"/>
<!-- Channel flat-list building and lookup by index/URL -->
<script type="text/brightscript" uri="pkg:/components/MainScene/ChannelList.brs"/>
<!-- Channel focus and selection event handlers -->
<script type="text/brightscript" uri="pkg:/components/MainScene/ChannelSelection.brs"/>
<!-- User-agent, content nodes, geometry, play/preview, pending headers -->
<script type="text/brightscript" uri="pkg:/components/MainScene/VideoCore.brs"/>
<!-- The unified retry ladder (steps 0-5+) -->
<script type="text/brightscript" uri="pkg:/components/MainScene/RetryLadder.brs"/>
<!-- Stream-outage retry loop (ladder exhausted, stream was playing) -->
<script type="text/brightscript" uri="pkg:/components/MainScene/StreamOutageLoop.brs"/>
<!-- Network-down detection and polling -->
<script type="text/brightscript" uri="pkg:/components/MainScene/NetworkDownProtocol.brs"/>
<!-- Brief pause before retrying on a clean (non-stall) error -->
<script type="text/brightscript" uri="pkg:/components/MainScene/ErrorDelayTimer.brs"/>
<!-- Channel navigation, reload, launch-fullscreen, video state observer -->
<script type="text/brightscript" uri="pkg:/components/MainScene/ChannelNav.brs"/>
<!-- Per-playlist favorites: storage, toggle, favorites grid view -->
<script type="text/brightscript" uri="pkg:/components/MainScene/Favorites.brs"/>
<script type="text/brightscript" uri="pkg:/components/MainScene/HiddenChannels.brs"/>
<!-- Bottom-third channel bar: logo, name, Favorite/CC/Details/Live buttons -->
<script type="text/brightscript" uri="pkg:/components/MainScene/ChannelBar.brs"/>
<!-- Audio, subtitle and channel-details option menus -->
<script type="text/brightscript" uri="pkg:/components/MainScene/MediaMenus.brs"/>
<!-- Visual overlays: channel info, errors, reconnect states, grid decorations -->
<script type="text/brightscript" uri="pkg:/components/MainScene/Overlays.brs"/>
<!-- Buffer progress bar, stall detection, slow-buffer step-down -->
<script type="text/brightscript" uri="pkg:/components/MainScene/BufferBar.brs"/>
<!-- UI inactivity timers: grid/fullscreen screensaver, quick-menu and dialog auto-close -->
<script type="text/brightscript" uri="pkg:/components/MainScene/Timers.brs"/>
<!-- Playback-health timers: stall, slow-buffer recovery, countdown, OK-suppression -->
<script type="text/brightscript" uri="pkg:/components/MainScene/PlaybackHealthTimers.brs"/>
<!-- Session-token stream refresh timer -->
<!-- onKeyEvent — reconnect-dialog intercept, inactivity resets, dispatch to fullscreen/grid -->
<script type="text/brightscript" uri="pkg:/components/MainScene/InputHandler.brs"/>
<!-- Fullscreen key handling: channel bar, surfing, quick menu, play/pause, replay -->
<script type="text/brightscript" uri="pkg:/components/MainScene/FullscreenInput.brs"/>
<!-- Grid key handling: channel list, playlist panel, favorite toggle, replay -->
<script type="text/brightscript" uri="pkg:/components/MainScene/GridInput.brs"/>
<!-- Per-channel stream settings cache (session + persistent) -->
<script type="text/brightscript" uri="pkg:/components/MainScene/SettingsCache.brs"/>
<!-- Builds the grid background texture at startup -->
<script type="text/brightscript" uri="pkg:/components/MainScene/BackgroundTexture.brs"/>

<children>
    <!-- Grid background: a stretched reflection sweep + a stretched vignette
         shadow, built at runtime in BackgroundTexture.brs
         (_buildGridBackgroundTexture, called from MainScene.brs init).
         A tiled metal-flake layer was tried here too and removed after
         review — see BackgroundTexture.brs for details.
         Same show/hide lifecycle as sidePanel/channelList (grid-only). -->
    <Group id="gridBackgroundTexture" visible="false"/>

    <Rectangle
        id="sidePanel"
        translation="[0, 0]"
        width="520"
        height="1080"
        color="0x8fcdc1DD"
        visible="false">
        
        <Poster
            id="logoImage"
            uri="pkg:/images/selectaview.png"
            translation="[1430,900]"
            width="400"
            height="100" />

        <LabelList
            id="playlistList"
            translation="[90, 100]"
            itemSize="[290, 60]"
            numRows="11"
            itemSpacing="[0, 10]"
            color="0x111111DD"/>
    </Rectangle>
    
    <LabelList
    	id="channelList"
    	translation="[580, 120]"
    	itemSize="[770, 50]"
    	numRows="16"
    	itemSpacing="[0, 5]"
        color="0xDDDDDDFF"
        focusedColor="0x111111FF"
        sectionDividerFont="font:SmallBoldSystemFont"
        sectionDividerTextColor="0x8fcdc1FF"
    	visible="false"/>

    <!-- Video preview in the grid -->
    <Video
        id="PreviewVideo"
        translation="[1380, 145]"
        width="444"
        height="250"
        visible="false"
        focusable="false"
        enableUI="false"/>

    <!-- Preview error overlay -->
    <Rectangle
        id="previewErrorContainer"
        translation="[1410, 210]"
        width="384"
        height="100"
        color="0x000000BB"
        visible="false">
        <Label
            translation="[0, 12]"
            text="Channel"
            font="font:MediumBoldSystemFont"
            color="0x8fcdc1FF"
            width="384"
            horizAlign="center"/>
        <Label
            translation="[0, 55]"
            text="Unavailable"
            font="font:MediumBoldSystemFont"
            color="0x8fcdc1FF"
            width="384"
            horizAlign="center"/>
    </Rectangle>

    <!-- Channel name under preview — original position, unchanged -->
    <Rectangle
        id="previewChannelNameContainer"
        translation="[1420, 455]"
        width="444"
        height="58"
        color="0x222222FF"
        visible="false">
        <Label
            id="previewChannelNameLabel"
            translation="[10, 10]"
            text=""
            font="font:SmallSystemFont"
            color="0xFFFFFFFF"
            width="424"
            height="38"
            wrap="true"
            maxLines="2"
            horizAlign="center"/>
    </Rectangle>

    <!-- Channel logo — separate, centered below the channel name box -->
    <Poster
        id="previewChannelLogo"
        translation="[1420, 630]"
        width="444"
        height="160"
        loadDisplayMode="scaleToFit"
        visible="false"/>

    <!-- Loaded playlist / favorites indicator — sits above the channel list -->
    <Rectangle
        id="channelListHeaderLabelContainer"
        translation="[550, 40]"
        width="830"
        height="58"
        color="0x8fcdc1DD"
        visible="false">
        <Label
            id="channelListHeaderLabel"
            translation="[10,10]"
            text=""
            font="font:MediumBoldSystemFont"
            color="0x222222FF"
            width="830"
            height="40"
            wrap="true"
            maxLines="2"
            horizAlign="center"
            visible="false"/>
    </Rectangle>

    <!-- TV overlaying preview -->
    <Poster
        id="TV overlay"
        uri="pkg:/images/retro-set.png"
        translation="[1410, 120]"
        width="480"
        height="327"
        visible="false"/>


    <!-- Bottom-third channel bar: logo, name, CC/Details/Live/Favorite icon buttons -->
    <!-- Replaces the old channel info banner + OK options dialog. -->
    <!-- Auto-shows on channel change, toggles via OK, focus index in m.barFocusIndex -->
    <!-- Height (150) is sized exactly to the tallest content (the logo,
         140px) plus 5px padding top and bottom, bottom edge anchored at
         the screen edge (y=930-1080). The logo sits at y=5 (using the
         full padding budget); the shorter name/button row (72px) is
         vertically centered within the 150px bar at y=39.

         Left to right: logo chained to the channel name (both right-
         aligned, name's right edge at x=940) — buttons, ending at x=1515.
         There used to be a clock at x=1610 (removed); the buttons' window
         was centered against its left edge and were left at that same
         position rather than re-centered in the now-clock-less space. -->
    <Rectangle
        id="channelBar"
        translation="[0, 930]"
        width="1920"
        height="150"
        color="0x024c48CC"
        visible="false">

        <!-- Left half (0-960): logo chained to the channel name, both
             right-aligned so the pair sits flush against the buttons at
             x=960 (20px margin) rather than centered or split apart. -->

        <!-- Logo — sits immediately left of the name -->
        <Poster
            id="channelBarLogo"
            translation="[240, 10]"
            width="300"
            height="130"
            loadDisplayMode="scaleToFit"
            visible="false"/>

        <!-- Server / playlist name — sits above the channel name -->
        <Label
            id="channelBarServerLabel"
            translation="[592, 10]"
            text=""
            font="font:SmallSystemFont"
            color="0x9FB5B0FF"
            width="754"
            height="64"
            vertAlign="center"
            horizAlign="left"
            wrap="false"
            maxLines="1"/>

        <!-- Channel name  -->
        <Label
            id="channelBarNameLabel"
            translation="[592, 72]"
            text=""
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            width="994"
            height="72"
            vertAlign="center"
            wrap="true"
            maxLines="1"/>

        <!-- Buttons -->
        <Rectangle
            id="channelBarFavoriteBtn"
            translation="[1248, 10]"
            width="56"
            height="56"
            color="0x3D5C56FF">
            <Poster
                id="channelBarFavoriteIcon"
                translation="[4, 4]"
                width="48"
                height="48"
                uri="pkg:/images/favorites.png"
                blendColor="0x9FB5B0FF"
                loadDisplayMode="scaleToFit"/>
        </Rectangle>

        <Rectangle
            id="channelBarCCBtn"
            translation="[1314, 10]"
            width="62"
            height="56"
            color="0x3D5C56FF">
            <Poster
                id="channelBarCCIcon"
                translation="[4, 4]"
                width="54"
                height="48"
                uri="pkg:/images/cc.png"
                blendColor="0x9FB5B0FF"
                loadDisplayMode="scaleToFit"/>
        </Rectangle>

        <Rectangle
            id="channelBarLiveBtn"
            translation="[1386, 10]"
            width="104"
            height="56"
            color="0x3D5C56FF">
            <Poster
                translation="[4, 4]"
                width="96"
                height="48"
                uri="pkg:/images/live.png"
                blendColor="0xFFFFFFFF"
                loadDisplayMode="scaleToFit"/>
        </Rectangle>

        <Rectangle
            id="channelBarDetailsBtn"
            translation="[1500, 10]"
            width="56"
            height="56"
            color="0x3D5C56FF">
            <Poster
                translation="[4, 4]"
                width="48"
                height="48"
                uri="pkg:/images/info.png"
                blendColor="0xFFFFFFFF"
                loadDisplayMode="scaleToFit"/>
        </Rectangle>

        <!-- Hide/Unhide: dimmed = hidden, bright = visible -- inverted from
             the Favorite/CC pattern above, since "bright" here means
             "currently showing", not "this toggle is active" -->
        <Rectangle
            id="channelBarHideBtn"
            translation="[1566, 10]"
            width="76"
            height="56"
            color="0x3D5C56FF">
            <Poster
                id="channelBarHideIcon"
                translation="[4, 4]"
                width="68"
                height="48"
                uri="pkg:/images/show_hide.png"
                blendColor="0xFFFFFFFF"
                loadDisplayMode="scaleToFit"/>
        </Rectangle>

    </Rectangle>

    <!-- Buffer progress bar -->
    <Rectangle
        id="bufferContainer"
        translation="[1467, 252]"
        width="283"
        height="36"
        color="0x000000FF"
        visible="false">
        <Rectangle
            id="bufferTrack"
            translation="[3, 3]"
            width="277"
            height="30"
            color="0x024c48FF"/>
        <Rectangle
            id="bufferFill"
            translation="[3, 3]"
            width="0"
            height="30"
            color="0x8fcdc1FF"/>
        <Label
            id="bufferLabel"
            translation="[0, 6]"
            text=""
            font="font:SmallSystemFont"
            color="0xFFFFFFFF"
            width="283"
            height="24"
            horizAlign="center"/>
    </Rectangle>

    <Rectangle
        id="channelOverlay"
        translation="[0, 0]"
        width="550"
        height="1080"
        color="0x024c48DE"
        visible="false">

        <LabelList
            id="channelOverlayList"
            translation="[50, 30]"
            itemSize="[460, 50]"
            numRows="18"
            color="0xFFFFFFFF"
            focusedColor="0x111111FF"
            itemSpacing="[0, 5]"/>
    </Rectangle>
    

    <!-- Screensaver / network-down shader overlay -->
    <Rectangle
        id="screensaverOverlay"
        translation="[0, 0]"
        width="1920"
        height="1080"
        color="0x000000CC"
        visible="false"/>

    <!-- Playlist loading indicator — plain overlay, not a native Dialog.
         Native Dialog behavior proved unreliable here across both
         buttonless (leaks all input, no dim) and buttoned (properly modal,
         but then blocks up/down before any custom key handling can see
         them) variants. This uses the same proven architecture as
         reconnectOverlay below: manual dim via screensaverOverlay, manual
         key handling in onKeyEvent. -->
    <Rectangle
        id="loadingOverlayBorder"
        translation="[706, 440]"
        width="508"
        height="200"
        color="0x8fcdc1FF"
        visible="false"/>

    <Rectangle
        id="loadingOverlay"
        translation="[710, 444]"
        width="500"
        height="192"
        color="0x024c48FF"
        visible="false">

        <BusySpinner
            id="loadingOverlaySpinner"
            translation="[216, 20]"/>

        <Label
            id="loadingOverlayLabel"
            translation="[20, 80]"
            text="Loading playlist..."
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF"
            width="460"
            height="40"
            horizAlign="center"/>

        <Label
            translation="[20, 145]"
            font="font:SmallSystemFont"
            color="0xAAAAAAFF"
            width="460"
            height="30"
            horizAlign="center"/>
    </Rectangle>

    <!-- Reconnecting overlay — shown when stream or network is down and retrying -->
    <!-- Sits above the screensaver shader -->
    <!-- Outline border: 4px teal ring -->
    <Rectangle
        id="reconnectOverlayBorder"
        translation="[606, 240]"
        width="708"
        height="608"
        color="0x8fcdc1FF"
        visible="false"/>

    <Rectangle
        id="reconnectOverlay"
        translation="[610, 244]"
        width="700"
        height="600"
        color="0x024c48FF"
        visible="false">

        <!-- Spinning indicator — centered horizontally -->
        <BusySpinner
            id="reconnectSpinner"
            translation="[316, 30]"
            visible="true"/>

        <!-- Channel name -->
        <Label
            id="reconnectChannelLabel"
            translation="[30, 120]"
            text=""
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            width="640"
            height="70"
            horizAlign="center"
            wrap="true"
            maxLines="2"/>

        <!-- Status line (retrying / network down / gave up) -->
        <Label
            id="reconnectStatusLabel"
            translation="[30, 210]"
            text=""
            font="font:MediumSystemFont"
            color="0x8fcdc1FF"
            width="640"
            height="50"
            horizAlign="center"
            wrap="true"
            maxLines="2"/>

        <!-- Error reason — shown in gave-up state only. Tall enough that a
             full "Playback error: ..." message wraps and shows completely
             instead of clipping. -->
        <Label
            id="reconnectErrorLabel"
            translation="[30, 265]"
            text=""
            font="font:SmallSystemFont"
            color="0xCCCCCCFF"
            width="640"
            height="220"
            horizAlign="center"
            wrap="true"
            maxLines="8"
            visible="false"/>

        <!-- Countdown line — shown during retry loops -->
        <Label
            id="reconnectCountdownLabel"
            translation="[30, 310]"
            text=""
            font="font:SmallSystemFont"
            color="0xAAAAAAFF"
            width="640"
            height="35"
            horizAlign="center"/>

        <!-- Action button — CANCEL while actively loading/retrying, RETRY
             once the gave-up state is reached (see reconnectActionLabel
             updates in Overlays.brs). OK does the corresponding action. -->
        <Rectangle
            id="reconnectRetryBtnBorder"
            translation="[223, 508]"
            width="254"
            height="44"
            color="0x8fcdc1FF"/>

        <Rectangle
            id="reconnectRetryBtn"
            translation="[225, 510]"
            width="250"
            height="40"
            color="0x024c48FF">
            <Label
                id="reconnectActionLabel"
                translation="[0, 4]"
                text="CANCEL"
                font="font:SmallSystemFont"
                color="0x8fcdc1FF"
                width="250"
                horizAlign="center"/>
        </Rectangle>
    </Rectangle>

    <!-- Shades the reconnect dialog itself (not just the background behind
         it) — starts hidden, shown after 30s of the gave-up state
         persisting unattended, or 30s into a second+ outage-loop cycle
         (perpetual retry with no end in sight). Declared after
         reconnectOverlay/reconnectOverlayBorder so it renders on top of
         them, unlike screensaverOverlay which only covers the background. -->
    <Rectangle
        id="reconnectDialogShade"
        translation="[0, 0]"
        width="1920"
        height="1080"
        color="0x000000CC"
        visible="false"/>

    <get_channel_list
    	id="get_channel_list"
    	control="STOP"/>

    <ManifestPatcher
        id="manifestPatcher"/>

    <LocalProxy
        id="localProxy"/>

    <!-- Custom text-entry dialog for playlist name/URL entry -- replaces
         StandardKeyboardDialog with our own themed, full-screen keyboard
         plus QR/phone text entry. See PhoneKeyboardDialog.xml's header
         comment for the full rationale. -->
    <PhoneKeyboardDialog
        id="phoneKeyboardDialog"
        visible="false"/>

    <!-- First-run welcome dialog -- shown before the add-playlist flow when
         no playlists exist yet. See WelcomeDialog.xml's header comment. -->
    <WelcomeDialog
        id="welcomeDialog"
        visible="false"/>

    <!-- Themed message popup (title + message + 1-2 buttons) -- replaces the
         stock Dialog node for Name/URL Required errors and channel info.
         See ThemedMessageDialog.xml's header comment. -->
    <ThemedMessageDialog
        id="themedMessageDialog"
        visible="false"/>

    <!-- Themed menu popup (title + vertical button list) -- replaces the
         stock Dialog node for the playlist options menu. See
         ThemedMenuDialog.xml's header comment. -->
    <ThemedMenuDialog
        id="themedMenuDialog"
        visible="false"/>

<!-- Deep linking (launch args + runtime roInputEvent) -->
<script type="text/brightscript" uri="pkg:/components/MainScene/DeepLink.brs"/>

</children>
</component>
